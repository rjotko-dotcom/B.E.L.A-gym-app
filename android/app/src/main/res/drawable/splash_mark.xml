<?xml version="1.0" encoding="utf-8"?>
<!-- The mark on the launch screen, as a vector. The system draws the splash
     icon at 240dp, about 720px on a Galaxy S24+, and the old source was the
     launcher foreground PNG (432px at most) stretched up to that — which is
     why it looked soft. A vector is sharp at any size. Same 108dp canvas and
     the same placement as ic_launcher_foreground, so nothing moves. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.060360"
        android:scaleY="0.060360"
        android:translateX="14.9167"
        android:translateY="17.4878">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M370,228 H740 A185,185 0 0 1 740,598 H710 A340,340 0 0 1 370,258 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M370,610 H700 C802,616 874,666 902,740 C814,700 722,728 662,802 C576,906 486,980 370,980 Z" />
    </group>
</vector>
