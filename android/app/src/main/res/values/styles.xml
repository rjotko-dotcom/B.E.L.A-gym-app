<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme — dark, so the shell never flashes white
         around the app. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/belaBlack</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/belaBlack</item>
        <item name="android:windowBackground">@color/belaBlack</item>
    </style>

    <!-- The launch screen: black, with the mark drawn once by the system.
         It used to also set android:background to a layer-list holding the
         same logo, so two surfaces drew it at two different sizes and the
         second one appeared as a jump. The splash-screen icon is the only
         thing that draws it now. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/belaBlack</item>
        <item name="windowSplashScreenBackground">@color/belaBlack</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
